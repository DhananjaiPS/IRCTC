model TrainInstance {
  id          BigInt   @id @default(autoincrement())
  scheduleId  BigInt?
  journeyDate DateTime @db.Date
  coachType   String // e.g., "AC1", "SL"

  totalSeats     Int
  availableSeats Int @default(72)
  bookedSeats    Int @default(0)
  racSeats       Int @default(5) // Future proofing for RAC
  wlSeats        Int @default(10) // Future proofing for Waitlist

  schedule    TrainSchedule?     @relation(fields: [scheduleId], references: [id])
  bookings    Booking[]
  seatRecords SeatAvailability[]

  @@unique([scheduleId, journeyDate, coachType])
  @@index([journeyDate, coachType])
}

model SeatAvailability {
  id              BigInt  @id @default(autoincrement())
  trainInstanceId BigInt?
  bookingId       BigInt?
  passengerId     BigInt? @unique

  coachId BigInt?
  seatId  BigInt?

  status SeatStatus @default(BOOKED)

  trainInstance TrainInstance? @relation(fields: [trainInstanceId], references: [id])
  booking       Booking?       @relation(fields: [bookingId], references: [id])
  coach         Coach?         @relation(fields: [coachId], references: [id])
  seat          Seat?          @relation(fields: [seatId], references: [id])
}

model Booking {
  id              BigInt        @id @default(autoincrement())
  pnr             String        @unique
  userId          String
  journeyDate     DateTime?     @db.Date // Removed optional
  trainInstanceId BigInt?
  scheduleId      BigInt
  fromStationId   String
  toStationId     String
  status          BookingStatus @default(BOOKED)
  totalFare       Float         @default(0.0) // Missing in your schema!

  bookedAt DateTime @default(now())

  trainInstance      TrainInstance?     @relation(fields: [trainInstanceId], references: [id])
  fromStation        Station            @relation("FromStation", fields: [fromStationId], references: [id])
  schedule           TrainSchedule      @relation(fields: [scheduleId], references: [id])
  toStation          Station            @relation("ToStation", fields: [toStationId], references: [id])
  user               User               @relation(fields: [userId], references: [id])
  passengers         Passenger[]
  payment            Payment?
  seatAvailabilities SeatAvailability[]

  @@index([userId, journeyDate])
  @@index([pnr])
}

